# Environment Variables Template for Frontend

# ============================================
# DEVELOPMENT ENVIRONMENT
# ============================================

# Backend API endpoint
VITE_BACKEND_URL=http://localhost:8080

# API Key for authentication
VITE_API_KEY=dev-key-123456789

# Encryption secret for wallet data
VITE_ENCRYPTION_SECRET=RAFSEN_SECURE_KEY_2024_DEV

# ============================================
# PRODUCTION ENVIRONMENT (EXAMPLE)
# ============================================
# Uncomment and modify for production:

# VITE_BACKEND_URL=https://api.your-domain.com
# VITE_API_KEY=your-secure-api-key-here
# VITE_ENCRYPTION_SECRET=your-secure-encryption-key-here

# ============================================
# IMPORTANT SECURITY NOTES:
# ============================================
# 1. Generate API_KEY with: openssl rand -base64 32
# 2. Generate ENCRYPTION_SECRET with: openssl rand -base64 32
# 3. NEVER commit real keys to git
# 4. Always use HTTPS in production
# 5. Store secrets in secure environment (GitHub Secrets, VPS env vars, etc.)
