# Backend Configuration Template for Java

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
server.port=8080

# Context path
server.servlet.context-path=/

# Compression
server.compression.enabled=true

# ============================================
# DATABASE/BLOCKCHAIN RPC CONFIGURATION
# ============================================

# RPC connection settings (use environment variables in production!)
rpc.host=${RPC_HOST:localhost}
rpc.port=${RPC_PORT:18776}
rpc.user=${RPC_USER:bitcoin}
rpc.password=${RPC_PASSWORD:password}

# ============================================
# API SECURITY - API KEY
# ============================================

# Generate with: openssl rand -base64 32
api.key=${API_KEY:dev-key-123456789}

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================

# Enable/disable rate limiting
ratelimit.enabled=true

# Requests per minute per IP
ratelimit.requests-per-minute=60

# Requests per hour per IP
ratelimit.requests-per-hour=500

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed origins (comma-separated)
server.servlet.cors.allowed-origins=${CORS_ORIGINS:http://localhost:5173,http://localhost:3000}

# Allowed HTTP methods
server.servlet.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers
server.servlet.cors.allowed-headers=Content-Type,X-API-Key,X-Signature,X-From-Address

# Allow credentials
server.servlet.cors.allow-credentials=true

# ============================================
# HTTPS/SSL CONFIGURATION (Production)
# ============================================

# Enable HTTPS
server.ssl.enabled=${SSL_ENABLED:false}

# Keystore file path (Let's Encrypt or self-signed)
server.ssl.key-store=${SSL_KEYSTORE_PATH:classpath:keystore.p12}

# Keystore password
server.ssl.key-store-password=${SSL_PASSWORD:changeit}

# Keystore type
server.ssl.key-store-type=PKCS12

# ============================================
# TWO-FACTOR AUTHENTICATION (2FA)
# ============================================

# Enable 2FA
2fa.enabled=false

# TOTP issuer name (appears in authenticator app)
2fa.issuer=Rafsen Wallet

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level
logging.level.root=INFO
logging.level.com.rafsen=DEBUG

# Log file
logging.file.name=logs/rafsen-wallet.log
logging.file.max-size=10MB
logging.file.max-history=7

# ============================================
# SPRING PROFILES
# ============================================

# Active profile (development or production)
spring.profiles.active=${SPRING_PROFILES_ACTIVE:development}

# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Set these on your VPS before running:
#
# export RPC_HOST=your-blockchain-node-ip
# export RPC_PORT=18776
# export RPC_USER=your-rpc-username
# export RPC_PASSWORD=your-rpc-password
# export API_KEY=your-secure-api-key
# export SSL_PASSWORD=your-keystore-password
# export CORS_ORIGINS=https://your-domain.com
# export SPRING_PROFILES_ACTIVE=production
# export SSL_ENABLED=true
